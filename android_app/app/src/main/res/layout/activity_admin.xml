<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".admin.AdminActivity">
    <ImageView
        android:id="@+id/imgLogout"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentRight="true"
        android:layout_marginRight="10dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/logout"/>
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_centerHorizontal="true"
        android:src="@drawable/logo"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/imgLogo"
        android:padding="10dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lunasima_bold"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:text="@string/admin"
            android:textSize="30dp" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/round_button_gray">

            <ImageButton
                android:id="@+id/btnManageFactory"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:src="@drawable/factory"
                android:background="@null"
                android:scaleType="fitStart"/>

            <TextView
                android:id="@+id/txtManageFactories"
                android:textColor="@color/dark_gray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:textStyle="bold"
                android:fontFamily="@font/oswald_bold"
                android:paddingHorizontal="10dp"
                android:paddingTop="10dp"
                android:text="@string/manage_factory"
                android:textSize="20dp" />
        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/round_button_gray">

            <ImageButton
                android:id="@+id/btnManageOperators"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:src="@drawable/operators"
                android:background="@null"
                android:scaleType="fitStart"/>

            <TextView
                android:id="@+id/txtManageOperators"
                android:textColor="@color/dark_gray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:textStyle="bold"
                android:fontFamily="@font/oswald_bold"
                android:paddingHorizontal="10dp"
                android:paddingTop="10dp"
                android:text="@string/manage_operators"
                android:textSize="20dp" />
        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/round_button_gray">

            <ImageButton
                android:id="@+id/btnManagePollutants"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:src="@drawable/emissions"
                android:background="@null"
                android:scaleType="fitStart"/>

            <TextView
                android:id="@+id/txtManagePollutants"
                android:textColor="@color/dark_gray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:textStyle="bold"
                android:fontFamily="@font/oswald_bold"
                android:paddingHorizontal="10dp"
                android:paddingTop="10dp"
                android:text="@string/manage_pollutants"
                android:textSize="20dp" />
        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/round_button_gray">

            <ImageButton
                android:id="@+id/btnViewReports"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:src="@drawable/report"
                android:background="@null"
                android:scaleType="fitStart"/>

            <TextView
                android:id="@+id/txtEmissionReport"
                android:textColor="@color/dark_gray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:textStyle="bold"
                android:fontFamily="@font/oswald_bold"
                android:paddingHorizontal="10dp"
                android:paddingTop="10dp"
                android:text="@string/view_emission_report"
                android:textSize="20dp" />
        </FrameLayout>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/light_gray"
        android:padding="10dp"
        android:gravity="center_horizontal"
        android:layout_alignParentBottom="true">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/imgHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/home" />
        <TextView
            android:id="@+id/txtHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lunasima_bold"
            android:text="@string/home"
            android:textColor="@color/dark_gray"
            android:layout_marginTop="2dp"
            android:layout_marginLeft="5dp"
            android:textSize="16dp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/imgProfile"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/profile" />
        <TextView
            android:id="@+id/txtProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lunasima_bold"
            android:text="@string/profile"
            android:textColor="@color/dark_gray"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="2dp"
            android:textSize="16dp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/imgSettings"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/settings" />
        <TextView
            android:id="@+id/txtSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lunasima_bold"
            android:text="@string/settings"
            android:textColor="@color/dark_gray"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="2dp"
            android:textSize="16dp" />
    </LinearLayout>
    </LinearLayout>

</RelativeLayout>