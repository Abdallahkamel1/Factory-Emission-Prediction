<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/curved_back"
    android:layout_marginVertical="10dp"
    android:padding="20dp">

    <TextView
        android:id="@+id/txtID"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:fontFamily="@font/oswald_bold"
        android:textColor="@color/green"
        android:gravity="center"
        android:text="Factory Name" />
    <TextView
        android:id="@+id/txtEmission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:layout_marginTop="5dp"
        android:fontFamily="@font/lunasima_regular"
        android:textColor="@color/black"
        android:gravity="center"
        android:textStyle="bold"
        android:text="Emission Level" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtCity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:layout_weight="1"
            android:background="@drawable/round_text"
            android:fontFamily="@font/lunasima_regular"
            android:padding="7dp"
            android:text="City"
            android:textColor="@color/black"
            android:gravity="center"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtYear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:padding="7dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/round_text"
            android:fontFamily="@font/lunasima_regular"
            android:textColor="@color/black"
            android:layout_gravity="right"
            android:gravity="center"
            android:text="Year" />
        <TextView
            android:id="@+id/txtFuel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:padding="7dp"
            android:gravity="center"
            android:layout_marginLeft="10dp"
            android:background="@drawable/round_text"
            android:fontFamily="@font/lunasima_regular"
            android:textColor="@color/black"
            android:layout_gravity="right"
            android:text="Fuel Type" />

    </LinearLayout>
        <TextView
        android:id="@+id/txtIndustry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:padding="7dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/round_text"
        android:fontFamily="@font/lunasima_regular"
        android:textColor="@color/black"
        android:layout_gravity="right"
        android:text="Industry Type" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/txtCO"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:layout_weight="1"
            android:padding="2dp"
            android:background="@drawable/round_text"
            android:fontFamily="@font/lunasima_regular"
            android:textColor="@color/green"
            android:textStyle="bold"
            android:gravity="center"
            android:text="CO" />
        <TextView
            android:id="@+id/txtSO"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:padding="2dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/round_text"
            android:fontFamily="@font/lunasima_regular"
            android:textColor="@color/green"
            android:textStyle="bold"
            android:gravity="center"
            android:text="SO" />
        <TextView
            android:id="@+id/txtNO"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:padding="2dp"
            android:background="@drawable/round_text"
            android:fontFamily="@font/lunasima_regular"
            android:textColor="@color/green"
            android:textStyle="bold"
            android:gravity="center"
            android:text="NO" />
        <TextView
            android:id="@+id/txtPM"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:padding="2dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/round_text"
            android:fontFamily="@font/lunasima_regular"
            android:textColor="@color/green"
            android:textStyle="bold"
            android:gravity="center"
            android:text="PM" />

    </LinearLayout>


</LinearLayout>